{%- comment -%}
  About page (design guide §9): short. Three or four voice lines, the phrase
  stamp, the logo stamp ("the mold", §2.1), the location line, and up to two
  detail photos (the kit's detail-seal.jpg and detail-side-stamp.jpg). Each voice line is a block so it stays editable.
  The stamp is this page's one stamp and one rotated element (§11).
{%- endcomment -%}
{{ 'wicz-home.css' | asset_url | stylesheet_tag }}

<section class="wicz-about page-width">
  <h1 class="wicz-about__title">{{ section.settings.heading | default: page.title }}</h1>

  <div class="wicz-about__body">
    <ul class="wicz-about__lines" role="list">
      {%- for block in section.blocks -%}
        <li class="wicz-about__line{% if block.settings.italic %} wicz-italic{% endif %}" {{ block.shopify_attributes }}>
          {{- block.settings.text -}}
        </li>
      {%- endfor -%}
    </ul>

    {%- if section.settings.show_stamp -%}
      {%- render 'wicz-stamp', text: section.settings.stamp_text, class: 'wicz-about__stamp' -%}
    {%- endif -%}
  </div>

  {%- if section.settings.image_1 != blank or section.settings.image_2 != blank -%}
    <div class="wicz-about__photos">
      {%- for image in (1..2) -%}
        {%- assign key = 'image_' | append: image -%}
        {%- assign photo = section.settings[key] -%}
        {%- if photo != blank -%}
          {{
            photo
            | image_url: width: 1200
            | image_tag: widths: '450, 750, 1000, 1200', sizes: '(min-width: 750px) 560px, 100vw', loading: 'lazy', class: 'wicz-about__photo'
          }}
        {%- endif -%}
      {%- endfor -%}
    </div>
  {%- endif -%}

  <div class="wicz-about__sign">
    {%- if section.settings.show_logo -%}
      <img src="{{ 'wicz-stamp.png' | asset_url }}" width="96" height="96" alt="the wicz craft butter stamp" loading="lazy" class="wicz-about__logo">
    {%- endif -%}
    {%- if section.settings.location_line != blank -%}
      <p class="wicz-about__location">{{ section.settings.location_line }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "wicz about",
  "class": "wicz-about-section",
  "max_blocks": 4,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "heading",
      "default": "about",
      "info": "leave blank to use the page title"
    },
    {
      "type": "checkbox",
      "id": "show_stamp",
      "label": "show stamp",
      "default": true
    },
    {
      "type": "text",
      "id": "stamp_text",
      "label": "stamp text",
      "default": "it's really good."
    },
    {
      "type": "checkbox",
      "id": "show_logo",
      "label": "show the logo stamp",
      "default": true
    },
    { "type": "image_picker", "id": "image_1", "label": "detail photo 1" },
    { "type": "image_picker", "id": "image_2", "label": "detail photo 2" },
    {
      "type": "text",
      "id": "location_line",
      "label": "location line",
      "default": "cultured butter · portland, oregon"
    }
  ],
  "blocks": [
    {
      "type": "line",
      "name": "voice line",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "line",
          "default": "we made butter. it's really good."
        },
        {
          "type": "checkbox",
          "id": "italic",
          "label": "italic accent",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "wicz about",
      "blocks": [
        { "type": "line" }
      ]
    }
  ]
}
{% endschema %}
