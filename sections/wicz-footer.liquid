{%- comment -%}
  wicz craft footer (design guide §7).
  Flat butter-yellow (no sheen: the sheen belongs to the butter, §6.1), a
  large stacked wordmark, the logo stamp ("the mold", §2.1) in deep
  periwinkle, the mono location line and one voice line. No stripes (§12).
  Legal links and copyright keep their normal case (§4.2).
{%- endcomment -%}
{{ 'wicz-footer.css' | asset_url | stylesheet_tag }}

<footer class="wicz-footer">
  <div class="wicz-footer__foil">
    <div class="wicz-footer__inner page-width">
      <a href="{{ routes.root_url }}" class="wicz-footer__wordmark wicz-display wicz-display--stacked">
        {%- assign words = section.settings.wordmark | default: 'wicz craft' | split: ' ' -%}
        {%- for word in words -%}
          <span>{{ word }}</span>
        {%- endfor -%}
      </a>

      <div class="wicz-footer__details">
        {%- if section.settings.show_logo -%}
          <img src="{{ 'wicz-stamp.png' | asset_url }}" width="120" height="120" alt="the wicz craft butter stamp" loading="lazy" class="wicz-footer__stamp">
        {%- endif -%}

        {%- if section.settings.voice_line != blank -%}
          <p class="wicz-footer__voice wicz-italic">{{ section.settings.voice_line }}</p>
        {%- endif -%}

        {%- if section.settings.location_line != blank -%}
          <p class="wicz-footer__location">{{ section.settings.location_line }}</p>
        {%- endif -%}

        {%- if section.settings.menu.links.size > 0 -%}
          <nav aria-label="footer">
            <ul class="wicz-footer__links" role="list">
              {%- for link in section.settings.menu.links -%}
                <li><a href="{{ link.url }}">{{ link.title | downcase }}</a></li>
              {%- endfor -%}
            </ul>
          </nav>
        {%- endif -%}

        {%- if section.settings.show_policies and shop.policies.size > 0 -%}
          <ul class="wicz-footer__legal wicz-legal" role="list">
            {%- for policy in shop.policies -%}
              {%- if policy != blank -%}
                <li><a href="{{ policy.url }}">{{ policy.title }}</a></li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}

        <p class="wicz-footer__copyright wicz-legal">
          &copy; {{ 'now' | date: '%Y' }} Wicz Craft
        </p>
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "wicz footer",
  "class": "wicz-footer-section",
  "enabled_on": {
    "groups": ["footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "wordmark",
      "label": "wordmark",
      "default": "wicz craft",
      "info": "each word stacks on its own line"
    },
    {
      "type": "text",
      "id": "location_line",
      "label": "location line",
      "default": "cultured butter · portland, oregon"
    },
    {
      "type": "text",
      "id": "voice_line",
      "label": "voice line",
      "default": "keep cold. spread generously."
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "menu",
      "default": "footer"
    },
    {
      "type": "checkbox",
      "id": "show_policies",
      "label": "show policy links",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_logo",
      "label": "show the logo stamp",
      "default": true
    }
  ]
}
{% endschema %}
