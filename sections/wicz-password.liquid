{%- comment -%}
  Password page (design guide §7, §9 tone): a dropped foil block with the
  stacked display line, the visitor message from Online Store > Preferences,
  and the storefront password form inline (no modal), then a stripe band.
  The foil block is the page's one rotated element (§11).
{%- endcomment -%}
{%- liquid
  assign words = section.settings.heading | newline_to_br | replace: '<br />', ' ' | split: ' '
  assign message = shop.password_message | default: section.settings.message
-%}

<section class="wicz-password page-width" aria-labelledby="WiczPasswordHeading">
  <div class="wicz-password__block foil foil--folds{% if section.settings.rotate %} foil--dropped{% endif %}">
    <h1 id="WiczPasswordHeading" class="wicz-display wicz-display--stacked wicz-password__heading">
      {%- for word in words -%}
        {%- if word != blank -%}
          <span>{{ word | strip }}</span>
        {%- endif -%}
      {%- endfor -%}
    </h1>

    <div class="wicz-password__side">
      {%- if message != blank -%}
        <p class="wicz-password__message">{{ message | escape }}</p>
      {%- endif -%}

      {%- form 'storefront_password', class: 'wicz-password__form' -%}
        <label class="wicz-password__label" for="WiczPassword">{{ section.settings.label }}</label>
        <div class="wicz-password__row">
          <input
            type="password"
            name="password"
            id="WiczPassword"
            class="wicz-password__input"
            autocomplete="current-password"
            required
            {% if form.errors %}
              aria-invalid="true"
              aria-describedby="WiczPasswordError"
              autofocus
            {% endif %}
          >
          <button type="submit" class="button wicz-password__button">{{ section.settings.button_label }}</button>
        </div>
        {%- if form.errors -%}
          <p id="WiczPasswordError" class="wicz-password__error" role="alert">{{ section.settings.error_text }}</p>
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>

  {%- if section.settings.show_stripes -%}
    <div class="wicz-password__stripes">
      {%- render 'wicz-carton-stripes', flavor: section.settings.stripe_flavor, height: 32, id: section.id -%}
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "wicz password",
  "class": "wicz-password-section",
  "settings": [
    {
      "type": "textarea",
      "id": "heading",
      "label": "stacked heading",
      "default": "really\ngood\nbutter",
      "info": "one word per line. lowercase."
    },
    {
      "type": "text",
      "id": "message",
      "label": "message",
      "default": "a portfolio demo. the password is on the link you were sent.",
      "info": "used when Online Store > Preferences has no visitor message"
    },
    { "type": "text", "id": "label", "label": "field label", "default": "password" },
    { "type": "text", "id": "button_label", "label": "button label", "default": "come in" },
    { "type": "text", "id": "error_text", "label": "wrong password text", "default": "that's not it. check the link you were sent." },
    { "type": "checkbox", "id": "rotate", "label": "drop the foil block", "default": true },
    { "type": "checkbox", "id": "show_stripes", "label": "show carton stripes", "default": true },
    {
      "type": "select",
      "id": "stripe_flavor",
      "label": "stripe colors",
      "default": "salted",
      "options": [
        { "value": "salted", "label": "salted (gold foil × periwinkle)" },
        { "value": "unsalted", "label": "unsalted (silver foil × periwinkle)" },
        { "value": "honey", "label": "honey (soft apricot × amber)" },
        { "value": "garlic-herb", "label": "garlic herb (soft pistachio × herb)" },
        { "value": "hot-honey", "label": "hot honey (apricot × magenta)" },
        { "value": "chili-crisp", "label": "chili crisp (oxblood × tangerine)" },
        { "value": "white-miso", "label": "white miso (lilac × kelly green)" },
        { "value": "caesar", "label": "caesar (pistachio × tomato)" },
        { "value": "smoked-sea-salt", "label": "smoked sea salt (charcoal × yolk)" },
        { "value": "french-onion", "label": "french onion (golden × red-onion purple)" },
        { "value": "cranberry-orange", "label": "cranberry orange (pale orange × cranberry)" },
        { "value": "brown-butter-sage", "label": "brown butter sage (brown butter × sage)" }
      ]
    }
  ]
}
{% endschema %}
