{%- comment -%}
  Product grid for the home page (design guide §9): the flavor grid (12 cards)
  and the flights row (3 cards with flavor dots) are both this section with
  a different collection. Cards are snippets/wicz-flavor-card.liquid.
  Hidden on the storefront when the collection is empty.
{%- endcomment -%}
{{ 'wicz-home.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign source = section.settings.collection
  assign limit = section.settings.limit
-%}

{%- if source.products_count > 0 or request.design_mode -%}
  <section class="wicz-grid-section page-width" aria-labelledby="Heading-{{ section.id }}">
    <div class="wicz-grid-section__head">
      <h2 id="Heading-{{ section.id }}" class="wicz-grid-section__heading">{{ section.settings.heading }}</h2>
      {%- if section.settings.link_label != blank and source != blank -%}
        <a href="{{ source.url }}" class="wicz-grid-section__link">{{ section.settings.link_label }}</a>
      {%- endif -%}
    </div>

    {%- if source.products_count > 0 -%}
      <ul
        class="wicz-grid wicz-grid--{{ section.settings.columns_desktop }}"
        role="list"
      >
        {%- for product in source.products limit: limit -%}
          <li class="wicz-grid__item">
            {%- render 'wicz-flavor-card', product: product -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- else -%}
      <p class="wicz-grid-section__empty">choose a collection with products in the theme editor.</p>
    {%- endif -%}
  </section>
{%- endif -%}

{% schema %}
{
  "name": "wicz product grid",
  "class": "wicz-grid-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "heading",
      "default": "the flavors"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "collection"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "products to show",
      "min": 1,
      "max": 12,
      "step": 1,
      "default": 5
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "columns on desktop",
      "default": "5",
      "options": [
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" },
        { "value": "5", "label": "5" }
      ]
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "link label",
      "default": "see all"
    }
  ],
  "presets": [
    {
      "name": "wicz product grid"
    }
  ]
}
{% endschema %}
