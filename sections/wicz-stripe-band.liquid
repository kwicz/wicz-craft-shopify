{%- comment -%}
  Carton stripe band (design guide §7) as its own section. On a product page
  it can take the product's colors from metafields; elsewhere it uses the
  chosen flavor pair.
{%- endcomment -%}
{%- liquid
  assign stripe_ground = blank
  assign stripe_ink = blank
  if section.settings.use_product_colors and product
    assign stripe_ground = product.metafields.custom.color_ground.value
    assign stripe_ink = product.metafields.custom.color_ink.value
  endif
-%}
<div class="wicz-stripe-band" style="margin: {{ section.settings.space }}px 0;">
  {%- render 'wicz-carton-stripes',
    flavor: section.settings.flavor,
    ground: stripe_ground,
    ink: stripe_ink,
    height: section.settings.height,
    id: section.id
  -%}
</div>

{% schema %}
{
  "name": "wicz stripe band",
  "class": "wicz-stripe-band-section",
  "settings": [
    {
      "type": "checkbox",
      "id": "use_product_colors",
      "label": "use the product's colors",
      "default": true,
      "info": "on product pages, reads custom.color_ground and custom.color_ink"
    },
    {
      "type": "select",
      "id": "flavor",
      "label": "colors otherwise",
      "default": "salted",
      "options": [
        { "value": "salted", "label": "nº 1 salted (butter × periwinkle)" },
        { "value": "garlic-herb", "label": "nº 2 garlic herb (pistachio × tomato)" },
        { "value": "honey", "label": "nº 3 honey (apricot × magenta)" },
        { "value": "white-miso", "label": "nº 4 white miso (lilac × kelly green)" },
        { "value": "chili-crisp", "label": "nº 5 chili crisp (oxblood × tangerine)" }
      ]
    },
    {
      "type": "range",
      "id": "height",
      "label": "height",
      "min": 16,
      "max": 64,
      "step": 8,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "space",
      "label": "space above and below",
      "min": 0,
      "max": 96,
      "step": 8,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "wicz stripe band"
    }
  ]
}
{% endschema %}
