{%- comment -%}
  Flavor dots for a carton (design guide §7), read from custom.carton_config.
  - slots mode: one dot per slot, filled with the slot's default flavor or
    left empty when the slot has no default.
  - capacity mode: one empty dot per slot of capacity.
  The carton builder re-renders the same markup live as flavors are picked.

  Accepts:
  - product: {Object} carton product with custom.carton_config
  - flavors: {Array} optional flavor products to resolve default handles
    (defaults to the product handles via all_products)

  Usage:
  {% render 'wicz-carton-dots', product: product %}
{%- endcomment -%}
{%- assign config = product.metafields.custom.carton_config.value -%}
{%- if config != blank -%}
  <ul class="wicz-dots" role="list" data-carton-dots>
    {%- if config.mode == 'slots' -%}
      {%- for slot in config.slots -%}
        {%- if slot.default != blank -%}
          {%- liquid
            assign flavor = all_products[slot.default]
            assign ground = flavor.metafields.custom.color_ground.value | default: settings.wicz_foil
            assign ink = flavor.metafields.custom.color_ink.value | default: settings.wicz_periwinkle
          -%}
          <li
            class="wicz-dots__dot{% if slot.size contains '2″' %} wicz-dots__dot--big{% endif %}"
            style="--dot-ground: {{ ground }}; --dot-ink: {{ ink }};"
            title="{{ flavor.title | escape }}, {{ slot.size }}"
          >
            <span class="visually-hidden">{{ flavor.title | escape }}, {{ slot.size }}</span>
          </li>
        {%- else -%}
          <li class="wicz-dots__dot wicz-dots__dot--empty{% if slot.size contains '2″' %} wicz-dots__dot--big{% endif %}">
            <span class="visually-hidden">empty {{ slot.size }} slot</span>
          </li>
        {%- endif -%}
      {%- endfor -%}
    {%- else -%}
      {%- for i in (1..config.capacity) -%}
        <li class="wicz-dots__dot wicz-dots__dot--empty">
          <span class="visually-hidden">empty slot</span>
        </li>
      {%- endfor -%}
    {%- endif -%}
  </ul>
{%- endif -%}
