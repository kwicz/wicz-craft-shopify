{%- comment -%}
  Outputs CSS custom property declarations for one product's flavor colors,
  read from product metafields (design guide §3.2). Use inside a style attribute:

    <div style="{% render 'wicz-flavor-vars', product: product %}">

  Accepts:
  - product: {Object} product with custom.color_ground / color_ink / color_deep
    (and optionally custom.color_fold)

  Outputs nothing when ground, ink or deep is missing, so the salted
  defaults in wicz-tokens.css apply.

  --flavor-text is the small-text color on the cream page. It is the deep
  color unless deep fails WCAG AA (4.5:1) on cream, in which case the ground
  color is used. That happens on the three dark grounds (chili crisp, smoked
  sea salt, brown butter sage), whose deep colors are light.

  --flavor-button-bg / --flavor-button-text: a flavor's primary button is its
  deep color with cream text; on dark grounds it's light-on-dark flipped:
  the light color as the fill and the ground as the text (§7). The guide
  says "ink" there; this uses deep, which equals the ink on two of the three
  dark grounds and on chili crisp is the lighter tangerine that passes AA
  against oxblood (#FF8A3D on #7A1E1E is 4.41:1).
{%- endcomment -%}
{%- liquid
  assign mf = product.metafields.custom
  if mf.color_ground != blank and mf.color_ink != blank and mf.color_deep != blank
    assign ground = mf.color_ground.value
    assign ink = mf.color_ink.value
    assign deep = mf.color_deep.value
    assign fold = mf.color_fold.value | default: ground

    assign text = deep
    assign deep_on_cream = deep | color_contrast: settings.wicz_cream
    if deep_on_cream < 4.5
      assign text = ground
    endif

    assign button_bg = deep
    assign button_text = settings.wicz_cream
    assign ground_brightness = ground | color_brightness
    if ground_brightness < 100
      assign button_bg = deep
      assign button_text = ground
    endif

    echo '--flavor-ground:' | append: ground | append: ';'
    echo '--flavor-ink:' | append: ink | append: ';'
    echo '--flavor-deep:' | append: deep | append: ';'
    echo '--flavor-fold:' | append: fold | append: ';'
    echo '--flavor-text:' | append: text | append: ';'
    echo '--flavor-text-rgb:' | append: text.red | append: ',' | append: text.green | append: ',' | append: text.blue | append: ';'
    echo '--flavor-button-bg:' | append: button_bg | append: ';'
    echo '--flavor-button-text:' | append: button_text | append: ';'
    echo '--flavor-button-bg-rgb:' | append: button_bg.red | append: ',' | append: button_bg.green | append: ',' | append: button_bg.blue | append: ';'
    echo '--flavor-button-text-rgb:' | append: button_text.red | append: ',' | append: button_text.green | append: ',' | append: button_text.blue | append: ';'
  endif
-%}
