{%- comment -%}
  Ingredients, allergen line, care line and "pairs with" for a product page
  (design guide §8.4, §9). Reads custom.ingredients, custom.allergens and
  custom.pairs_with. The block's allergen line is the fallback when a product
  has no custom.allergens.

  Accepts:
  - product: {Object}
  - block: {Object} main-product block with show_ingredients, allergen_line,
    care_line and show_pairs_with settings
{%- endcomment -%}
{%- liquid
  assign ingredients = product.metafields.custom.ingredients.value
  assign pairs_with = product.metafields.custom.pairs_with.value
  assign allergens = product.metafields.custom.allergens.value | default: block.settings.allergen_line
-%}
<dl class="wicz-facts" {{ block.shopify_attributes }}>
  {%- if block.settings.show_ingredients and ingredients != blank -%}
    <div class="wicz-facts__row">
      <dt class="wicz-facts__label">ingredients</dt>
      <dd class="wicz-facts__value">
        {{ ingredients | newline_to_br }}
        {%- if allergens != blank -%}
          <br><span class="wicz-facts__allergen">{{ allergens }}</span>
        {%- endif -%}
      </dd>
    </div>
  {%- endif -%}

  {%- if block.settings.care_line != blank -%}
    <div class="wicz-facts__row">
      <dt class="wicz-facts__label">care</dt>
      <dd class="wicz-facts__value">{{ block.settings.care_line }}</dd>
    </div>
  {%- endif -%}

  {%- if block.settings.show_pairs_with and pairs_with != blank -%}
    <div class="wicz-facts__row">
      <dt class="wicz-facts__label">pairs with</dt>
      <dd class="wicz-facts__value">{{ pairs_with }}</dd>
    </div>
  {%- endif -%}
</dl>
